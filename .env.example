# Genkit / Google AI API Key (Required for AI features if implemented)
# Get yours from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY=YOUR_GOOGLE_API_KEY

# Cloud Sync Configuration (Optional - Required for OneDrive/Google Drive sync)
# These would typically be obtained via OAuth flows in a real application
# For development/testing, you might manually obtain and store them, but this is not secure for production.
# ONEDRIVE_CLIENT_ID=YOUR_ONEDRIVE_APP_CLIENT_ID
# ONEDRIVE_CLIENT_SECRET=YOUR_ONEDRIVE_APP_CLIENT_SECRET
# ONEDRIVE_REDIRECT_URI=YOUR_ONEDRIVE_APP_REDIRECT_URI

# Google OAuth Configuration (Required for Google Calendar and Drive integration)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_APP_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_APP_CLIENT_SECRET
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:9002/auth/callback/google

# Microsoft Graph API Configuration (Required for Microsoft Calendar and OneDrive integration)
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_APP_CLIENT_ID
MICROSOFT_CLIENT_SECRET=YOUR_MICROSOFT_APP_CLIENT_SECRET
NEXT_PUBLIC_MICROSOFT_REDIRECT_URI=http://localhost:9002/auth/callback/microsoft
MICROSOFT_TENANT_ID=YOUR_MICROSOFT_TENANT_ID

# Note: Access tokens for cloud providers are typically stored in localStorage
# after the user authenticates via OAuth, not directly in .env files.
